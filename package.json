{
  "name": "order-outbox-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Transactional outbox with Postgres SKIP LOCKED, competing-consumer stage workers, and live SSE fan-out",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "vendor": "mkdir -p public/vendor && cp node_modules/dayjs/dayjs.min.js public/vendor/ && cp node_modules/dayjs/plugin/utc.js public/vendor/dayjs-utc.js && cp node_modules/dayjs/plugin/localizedFormat.js public/vendor/dayjs-localizedFormat.js",
    "build": "pnpm run vendor && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migration:run": "node dist/infrastructure/database/migrate.js",
    "test": "jest",
    "load": "node --env-file-if-exists=.env --import tsx tools/load-generator/generate.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/serve-static": "^5.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "dayjs": "^1.11.23",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@base/(.*)$": "<rootDir>/base/$1",
      "^@config$": "<rootDir>/config",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1"
    }
  }
}
