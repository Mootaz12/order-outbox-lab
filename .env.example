# Connection strings for the app. docker-compose.yml sets these for containers;
# this file is what you'd use running `pnpm start:dev` against a locally started stack.
DATABASE_URL=postgres://app:app@localhost:5432/orders
REDIS_URL=redis://localhost:6379
INSTANCE_ID=instance-local
PORT=3000

# Not read by the app: base URL for the load generator (`pnpm load ...`, tools/load-generator).
# Defaults to the nginx entry point of the docker compose stack.
TARGET_URL=http://localhost:8080
